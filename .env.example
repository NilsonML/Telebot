# Скопируй в .env и заполни. Файл .env в git не попадает (.gitignore).
TG_TOKEN=          # токен бота от @BotFather
AI_TOKEN=          # ключ OpenRouter (https://openrouter.ai/keys)
ADMIN_ID=          # твой Telegram user id — доступ к /admin
BOT_TIMEZONE=Europe/Moscow   # в каком поясе пользователи вводят время напоминаний
